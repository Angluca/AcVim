--langdef=mach
--langmap=mach:.mach
--language-force=mach
--exclude=Makefile
--exclude=*.toml
--exclude=*.env
--exclude=*.mak
--exclude=*.tags
--exclude=*.md
--exclude=*.txt
--exclude=*.py
--exclude=*.js
--exclude=*.html
--exclude=out/*
--regex-mach=/\s*(val|var)\s+(\w+)/\2/v,var/
--regex-mach=/\s*fun\s+(\w+)/\1/f,fun/
--regex-mach=/\s*rec\s+(\w+)/\1/r,rec/
--regex-mach=/\s*uni\s+(\w+)/\1/u,uni/
--regex-mach=/^\s*(use|fwd)\s+(\w+)\s*[:;]/\2/m,mod/
--regex-mach=/^\s*(use|fwd)\s+[^:]*\.(\w+)\s*;/\2/m,mod/
--regex-mach=/^\s*(\w+)\s*[:]/\1/v,var/
--regex-mach=/^\s*(\w+)\s*[,]\n/\1/v,var/

